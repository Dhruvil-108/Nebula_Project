@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    color-scheme: light;
    --post-login-sidebar: #ffffff;
    --post-login-sidebar-active: #fff7ed;
    --post-login-sidebar-active-border: #fed7aa;
    --post-login-sidebar-active-text: #ea580c;
    --post-login-sidebar-active-icon: #f97316;
    --post-login-sidebar-hover: #fffaf5;
    --post-login-sidebar-text: #334155;
    --post-login-sidebar-muted: #64748b;
    --post-login-sidebar-border: #f1f5f9;
    --post-login-page: #f8fafc;
    --post-login-card: #ffffff;
    --post-login-card-alt: #ffffff;
    --post-login-border: #e2e8f0;
    --post-login-orange: #f97316;
    --post-login-orange-hover: #ea580c;
    --post-login-text: #0f172a;
    --post-login-text-secondary: #475569;
    --post-login-text-muted: #94a3b8;
    --brand: #f97316;
    --brand-hover: #ea580c;
    --brand-soft: rgba(249, 115, 22, 0.12);
    --bg-canvas: #ffffff;
    --bg-surface: #f8fafc;
    --bg-card: #ffffff;
    --line: rgba(15, 23, 42, 0.08);
  }

  html {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  body {
    background-color: #ffffff;
    color: #0f172a;
    overflow-x: hidden;
  }
}

/* Authenticated UI only. Auth and public pages retain their existing theme. */
.authenticated-shell {
  color-scheme: light;
  background-color: var(--post-login-page) !important;
  color: var(--post-login-text);
}

.authenticated-shell>div,
.authenticated-shell main,
.authenticated-shell .post-login-topbar {
  background-color: var(--post-login-page) !important;
}

.authenticated-shell .post-login-topbar {
  border-color: var(--post-login-border) !important;
}

/* ── Sidebar System: Clean Background with Light Orange Active Item ── */
.authenticated-shell .post-login-sidebar,
.authenticated-shell .post-login-sidebar.bg-slate-950,
.authenticated-shell .post-login-sidebar.bg-\[\#0b0f17\] {
  background-color: var(--post-login-sidebar) !important;
  color: var(--post-login-sidebar-text);
  border-color: var(--post-login-sidebar-border) !important;
}

.authenticated-shell .post-login-sidebar [class*="border-slate-"] {
  border-color: var(--post-login-sidebar-border) !important;
}

.authenticated-shell .post-login-sidebar [class*="text-slate-500"],
.authenticated-shell .post-login-sidebar [class*="text-slate-400"] {
  color: var(--post-login-sidebar-muted) !important;
}

.authenticated-shell .post-login-sidebar [class*="text-slate-300"],
.authenticated-shell .post-login-sidebar [class*="text-slate-200"],
.authenticated-shell .post-login-sidebar [class*="text-slate-100"] {
  color: var(--post-login-sidebar-text) !important;
}

.authenticated-shell .post-login-sidebar .text-white {
  color: var(--post-login-text) !important;
}

/* Unselected items default styling */
.authenticated-shell .post-login-sidebar .post-login-nav-item:not(.post-login-nav-active) {
  color: var(--post-login-sidebar-text) !important;
  background-color: transparent !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-item:not(.post-login-nav-active) svg {
  color: var(--post-login-sidebar-muted) !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-item:not(.post-login-nav-active) span {
  color: var(--post-login-sidebar-text) !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-item:hover:not(.post-login-nav-active) {
  background-color: var(--post-login-sidebar-hover) !important;
  color: #1a1a1a !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-item:hover:not(.post-login-nav-active) svg {
  color: #ea580c !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-item:hover:not(.post-login-nav-active) span {
  color: #1a1a1a !important;
}

/* ── Selected / Active module on Sidebar ── */
/* Light orange background with module name clearly visible */
.authenticated-shell .post-login-sidebar .post-login-nav-active {
  background-color: var(--post-login-sidebar-active) !important;
  border: 1px solid var(--post-login-sidebar-active-border) !important;
  color: var(--post-login-sidebar-active-text) !important;
  box-shadow: 0 1px 3px rgba(234, 88, 12, 0.08) !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-active svg {
  color: var(--post-login-sidebar-active-icon) !important;
}

.authenticated-shell .post-login-sidebar .post-login-nav-active span {
  color: var(--post-login-sidebar-active-text) !important;
  font-weight: 600 !important;
}

/* Chevron on active group */
.authenticated-shell .post-login-sidebar .post-login-nav-active svg.lucide-chevron-down {
  color: var(--post-login-sidebar-active-icon) !important;
}

/* Workspace card in sidebar */
.authenticated-shell .post-login-sidebar [class*="bg-slate-900/80"],
.authenticated-shell .post-login-sidebar [class*="bg-[#fbf0e7]"] {
  background-color: #fbf0e7 !important;
  border-color: var(--post-login-sidebar-border) !important;
}

.authenticated-shell .post-login-sidebar .sidebar-workspace-mark {
  background-color: #ffffff !important;
  border-color: #fcd4b0 !important;
  color: var(--post-login-sidebar-active-icon) !important;
}

/* User Menu in sidebar */
.authenticated-shell .post-login-sidebar [class*="bg-slate-800/60"] {
  background-color: var(--post-login-sidebar-hover) !important;
}

.authenticated-shell .post-login-sidebar [class*="hover\\:bg-slate-800"]:hover {
  background-color: var(--post-login-sidebar-hover) !important;
}

.authenticated-shell .post-login-sidebar .sidebar-user-role {
  color: var(--post-login-sidebar-muted) !important;
}

/* User Menu popover */
.authenticated-shell .post-login-sidebar [class*="bg-slate-900"] {
  background-color: #ffffff !important;
  border-color: var(--post-login-sidebar-border) !important;
  box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1) !important;
}

.authenticated-shell .post-login-sidebar [class*="bg-slate-900"] p,
.authenticated-shell .post-login-sidebar [class*="bg-slate-900"] button {
  color: var(--post-login-text) !important;
}

.authenticated-shell .post-login-sidebar [class*="bg-slate-900"] button:hover {
  background-color: var(--post-login-sidebar-hover) !important;
  color: #1a1a1a !important;
}

.authenticated-shell>div>main [class*="bg-slate-"] {
  background-color: var(--post-login-card) !important;
}

.authenticated-shell>div>main [class*="bg-slate-950/"],
.authenticated-shell>div>main [class*="bg-slate-900/"],
.authenticated-shell>div>main [class*="bg-slate-800/"] {
  background-color: var(--post-login-card-alt) !important;
}

.authenticated-shell>div>main [class*="border-slate-"] {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell>div>main [class*="text-white"],
.authenticated-shell>div>main [class*="text-slate-50"],
.authenticated-shell>div>main [class*="text-slate-100"],
.authenticated-shell>div>main [class*="text-slate-200"],
.authenticated-shell>div>main [class*="text-slate-300"] {
  color: var(--post-login-text) !important;
}

.authenticated-shell>div>main [class*="text-slate-400"] {
  color: var(--post-login-text-secondary) !important;
}

.authenticated-shell>div>main [class*="text-slate-500"],
.authenticated-shell>div>main [class*="text-slate-600"] {
  color: var(--post-login-text-muted) !important;
}

.authenticated-shell>div>main [class*="bg-[#f0512f]"],
.authenticated-shell>div>main [class*="bg-indigo-"] {
  background-color: var(--post-login-orange) !important;
}

.authenticated-shell>div>main [class*="text-[#f0512f]"],
.authenticated-shell>div>main [class*="text-[#ff7a59]"] {
  color: var(--post-login-orange) !important;
}

.authenticated-shell>div>main [class*="border-[#f0512f]"] {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell>div>main [class*="hover\\:bg-indigo-"]:hover,
.authenticated-shell>div>main [class*="hover\\:bg-[#d63f1e]"]:hover {
  background-color: var(--post-login-orange-hover) !important;
}

/* Profile hero is intentionally dark inside the light authenticated canvas. */
.authenticated-shell .post-login-profile-hero [class*="bg-slate-"] {
  background-color: rgba(11, 15, 23, 0.6) !important;
}

.authenticated-shell .post-login-profile-hero [class*="border-slate-"] {
  border-color: rgba(255, 255, 255, 0.14) !important;
}

.authenticated-shell .post-login-profile-hero .text-white {
  color: #ffffff !important;
}

.authenticated-shell .post-login-profile-hero .text-slate-200,
.authenticated-shell .post-login-profile-hero .text-slate-300,
.authenticated-shell .post-login-profile-hero .text-slate-400 {
  color: #d7dee8 !important;
}

.authenticated-shell .post-login-profile-hero .text-slate-500,
.authenticated-shell .post-login-profile-hero .text-slate-600 {
  color: #aab6c5 !important;
}

.authenticated-shell .account-creator-form {
  background-color: var(--post-login-card-alt) !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text);
}

.authenticated-shell .account-creator-form>.absolute {
  display: none !important;
}

.authenticated-shell .account-creator-form [class*="text-white"],
.authenticated-shell .account-creator-form [class*="text-slate-200"],
.authenticated-shell .account-creator-form [class*="text-slate-300"] {
  color: var(--post-login-text) !important;
}

.authenticated-shell .account-creator-form [class*="text-slate-400"] {
  color: var(--post-login-text-secondary) !important;
}

.authenticated-shell .account-creator-form [class*="text-slate-500"] {
  color: var(--post-login-text-muted) !important;
}

.authenticated-shell .account-creator-page [class*="bg-indigo-"] {
  background-color: var(--brand-soft) !important;
}

.authenticated-shell .account-creator-form [class*="border-slate-"] {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .account-creator-form input {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text) !important;
}

.authenticated-shell .account-creator-form input::placeholder {
  color: var(--post-login-text-muted) !important;
}

.authenticated-shell .account-creator-form input:focus {
  border-color: var(--post-login-orange) !important;
  --tw-ring-color: rgba(194, 84, 12, 0.25) !important;
}

.authenticated-shell .account-creator-form button[type="submit"] {
  background: var(--post-login-orange) !important;
  color: #ffffff !important;
}

.authenticated-shell .account-creator-form button[type="submit"]:hover {
  background: var(--post-login-orange-hover) !important;
}

.authenticated-shell .account-creator-form [class*="bg-indigo-"] {
  background-color: var(--brand-soft) !important;
}

.authenticated-shell .account-creator-page [class*="text-indigo-"] {
  color: var(--post-login-orange) !important;
}

.authenticated-shell .account-creator-form [class*="border-indigo-"] {
  border-color: var(--post-login-orange) !important;
}

.authenticated-shell .account-creator-page [class*="border-indigo-"] {
  border-color: var(--post-login-orange) !important;
}

.authenticated-shell .account-creator-form [class*="ring-indigo-"] {
  --tw-ring-color: var(--post-login-orange) !important;
}

.authenticated-shell .account-creator-form .account-role-option-selected {
  background-color: var(--post-login-orange) !important;
  border-color: var(--post-login-orange) !important;
  color: #ffffff !important;
}

.authenticated-shell .account-creator-form .account-role-option-selected>span:last-child {
  color: #ffffff !important;
}

.authenticated-shell .account-creator-roster {
  background-color: var(--post-login-card-alt) !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text);
}

.authenticated-shell .account-creator-roster [class*="text-white"],
.authenticated-shell .account-creator-roster [class*="text-slate-200"],
.authenticated-shell .account-creator-roster [class*="text-slate-300"] {
  color: var(--post-login-text) !important;
}

.authenticated-shell .account-creator-roster [class*="text-slate-400"] {
  color: var(--post-login-text-secondary) !important;
}

.authenticated-shell .account-creator-roster [class*="text-slate-500"],
.authenticated-shell .account-creator-roster [class*="text-slate-600"] {
  color: var(--post-login-text-muted) !important;
}

.authenticated-shell .account-creator-roster [class*="border-slate-"] {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .account-creator-roster input {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text) !important;
}

.authenticated-shell .account-creator-roster input::placeholder {
  color: var(--post-login-text-muted) !important;
}

.authenticated-shell .account-creator-roster input:focus {
  border-color: var(--post-login-orange) !important;
  --tw-ring-color: rgba(194, 84, 12, 0.25) !important;
}

.authenticated-shell .account-creator-roster [class*="bg-indigo-"] {
  background-color: var(--brand-soft) !important;
}

/* CRM filters and form selects use the same light authenticated palette. */
.authenticated-shell .crm-submodule-page select {
  color-scheme: light;
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text) !important;
}

.authenticated-shell .crm-submodule-page select:focus {
  border-color: var(--post-login-orange) !important;
  --tw-ring-color: rgba(194, 84, 12, 0.25) !important;
}

.authenticated-shell .crm-submodule-page select option {
  background-color: #ffffff;
  color: var(--post-login-text);
}

/* Permissions Page Theme Styles */
.authenticated-shell .permissions-page {
  color: var(--post-login-text);
}

.authenticated-shell .permissions-page input[type="text"] {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text) !important;
}

.authenticated-shell .permissions-page input[type="text"]:focus {
  border-color: var(--post-login-orange) !important;
  --tw-ring-color: rgba(194, 84, 12, 0.25) !important;
}

.authenticated-shell .permissions-page .permissions-callout {
  background-color: var(--post-login-card-alt) !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-grid {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-grid thead,
.authenticated-shell .permissions-page .permissions-grid thead tr,
.authenticated-shell .permissions-page .permissions-grid th {
  background-color: #fbf5f0 !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-grid th:first-child {
  background-color: #fbf5f0 !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-grid th>div {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-grid tbody tr {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-role-cell {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .permissions-page .permissions-grid tbody tr:hover .permissions-role-cell {
  background-color: #fffbf8 !important;
}

.authenticated-shell .permissions-page .permissions-grid td {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .dashboard-page,
.authenticated-shell .profile-page {
  color: var(--post-login-text);
}

.authenticated-shell .dashboard-page [class*="bg-gradient-to"],
.authenticated-shell .profile-page [class*="bg-gradient-to"] {
  background-image: none !important;
  background-color: var(--post-login-card) !important;
}

.authenticated-shell .dashboard-page [class*="border-slate-"],
.authenticated-shell .profile-page [class*="border-slate-"] {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .dashboard-page [class*="text-white"],
.authenticated-shell .dashboard-page [class*="text-slate-50"],
.authenticated-shell .dashboard-page [class*="text-slate-100"],
.authenticated-shell .dashboard-page [class*="text-slate-200"],
.authenticated-shell .dashboard-page [class*="text-slate-300"],
.authenticated-shell .profile-page [class*="text-slate-50"],
.authenticated-shell .profile-page [class*="text-slate-100"],
.authenticated-shell .profile-page [class*="text-slate-200"],
.authenticated-shell .profile-page [class*="text-slate-300"] {
  color: var(--post-login-text) !important;
}

.authenticated-shell .dashboard-page [class*="text-slate-400"],
.authenticated-shell .profile-page [class*="text-slate-400"] {
  color: var(--post-login-text-secondary) !important;
}

.authenticated-shell .dashboard-page [class*="text-slate-500"],
.authenticated-shell .dashboard-page [class*="text-slate-600"],
.authenticated-shell .profile-page [class*="text-slate-500"],
.authenticated-shell .profile-page [class*="text-slate-600"] {
  color: var(--post-login-text-muted) !important;
}

.authenticated-shell .dashboard-page [class*="text-emerald-400"],
.authenticated-shell .profile-page [class*="text-emerald-400"] {
  color: #047857 !important;
}

.authenticated-shell .dashboard-page [class*="text-amber-400"],
.authenticated-shell .profile-page [class*="text-amber-400"] {
  color: #92400e !important;
}

.authenticated-shell .dashboard-page [class*="text-rose-400"],
.authenticated-shell .profile-page [class*="text-rose-400"] {
  color: #be123c !important;
}

.authenticated-shell .dashboard-page [class*="text-sky-400"],
.authenticated-shell .profile-page [class*="text-sky-400"] {
  color: #0369a1 !important;
}

.authenticated-shell .dashboard-page [class*="bg-slate-900"],
.authenticated-shell .dashboard-page [class*="bg-slate-950"],
.authenticated-shell .profile-page [class*="bg-slate-900"],
.authenticated-shell .profile-page [class*="bg-slate-950"] {
  background-color: var(--post-login-card-alt) !important;
}

.authenticated-shell .dashboard-page [class*="bg-[#f0512f]"],
.authenticated-shell .profile-page [class*="bg-[#f0512f]"] {
  background-color: var(--post-login-orange) !important;
}

.authenticated-shell .dashboard-page [class*="text-[#f0512f]"],
.authenticated-shell .profile-page [class*="text-[#f0512f]"],
.authenticated-shell .dashboard-page [class*="text-[#ff7a59]"],
.authenticated-shell .profile-page [class*="text-[#ff7a59]"] {
  color: var(--post-login-orange) !important;
}

.authenticated-shell .dashboard-page input,
.authenticated-shell .profile-page input,
.authenticated-shell .profile-page textarea {
  color: var(--post-login-text) !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .dashboard-page input:focus,
.authenticated-shell .profile-page input:focus,
.authenticated-shell .profile-page textarea:focus {
  border-color: var(--post-login-orange) !important;
  --tw-ring-color: rgba(249, 115, 22, 0.25) !important;
}

html {
  scroll-behavior: smooth;
}

/* Landing Page Clean Light Theme Guarantee */
.landing-page {
  color-scheme: light;
  background-color: #ffffff;
  color: #0f172a;
}

.authenticated-shell .profile-page .post-login-profile-hero {
  background: var(--post-login-card-alt) !important;
  border-color: var(--post-login-border) !important;
  color: var(--post-login-text) !important;
}

.authenticated-shell .profile-page .post-login-profile-hero .text-white,
.authenticated-shell .profile-page .post-login-profile-hero .text-slate-200,
.authenticated-shell .profile-page .post-login-profile-hero .text-slate-300 {
  color: var(--post-login-text) !important;
}

.authenticated-shell .profile-page .post-login-profile-hero .text-slate-400,
.authenticated-shell .profile-page .post-login-profile-hero .text-slate-500,
.authenticated-shell .profile-page .post-login-profile-hero .text-slate-600 {
  color: var(--post-login-text-secondary) !important;
}

.authenticated-shell .profile-page .post-login-profile-hero [class*="border-slate-"] {
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .profile-page .post-login-profile-hero .profile-status-pill {
  background-color: #f1f5f9 !important;
  border-color: #cbd5e1 !important;
  color: #334155 !important;
}

.authenticated-shell .profile-page .post-login-profile-hero .profile-time-card {
  background-color: #ffffff !important;
  border-color: var(--post-login-border) !important;
}

.authenticated-shell .profile-page .post-login-profile-hero .profile-time-card .text-white,
.authenticated-shell .profile-page .post-login-profile-hero .profile-time-card .text-slate-300 {
  color: var(--post-login-text) !important;
}

.authenticated-shell .profile-page .post-login-profile-hero .profile-time-card .text-slate-500 {
  color: var(--post-login-text-secondary) !important;
}

.theme-toast-container .Toastify__toast-icon {
  color: var(--post-login-orange) !important;
}

.theme-toast-container .Toastify__toast-icon svg {
  fill: var(--post-login-orange) !important;
  color: var(--post-login-orange) !important;
}

.theme-toast-container .Toastify__close-button {
  color: var(--post-login-text-secondary) !important;
  opacity: 1 !important;
}

.theme-toast-container .theme-toast-progress,
.theme-toast-container .Toastify__progress-bar {
  background: var(--post-login-orange-hover) !important;
}

@layer utilities {
  .bg-radial-gradient {
    background: radial-gradient(circle at 50% 0%, rgba(240, 81, 47, 0.08) 0%, rgba(255, 255, 255, 0) 70%);
  }

  .bg-radial-glow {
    background: radial-gradient(circle at 50% 50%, rgba(240, 81, 47, 0.06) 0%, rgba(255, 255, 255, 0) 65%);
  }

  .bg-grid-pattern {
    background-size: 44px 44px;
    background-image:
      linear-gradient(to right, rgba(15, 23, 42, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
  }

  .bg-dot-pattern {
    background-size: 24px 24px;
    background-image: radial-gradient(rgba(240, 81, 47, 0.12) 1px, transparent 1px);
  }

  .glass-card {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
  }

  .glass-card-hover {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .glass-card-hover:hover {
    background: #ffffff;
    border-color: rgba(240, 81, 47, 0.35);
    box-shadow: 0 12px 30px -8px rgba(240, 81, 47, 0.12);
    transform: translateY(-2px);
  }

  .glass-pill {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.85);
  }

  .text-gradient {
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #475569 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-accent {
    background: linear-gradient(135deg, #f0512f 0%, #ea580c 55%, #c2410c 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-brand {
    background: linear-gradient(135deg, #ff7a59 0%, #f0512f 50%, #d63f1e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-gradient-indigo {
    background: linear-gradient(135deg, #ff7a59 0%, #f0512f 50%, #d63f1e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .zorvi-glow {
    box-shadow: 0 4px 25px -4px rgba(240, 81, 47, 0.2);
  }

  .bg-gradient-radial {
    background-image: radial-gradient(var(--tw-gradient-stops));
  }
}

/* Custom scrollbar matching Zorvi design */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: #f8fafc;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(240, 81, 47, 0.7);
}